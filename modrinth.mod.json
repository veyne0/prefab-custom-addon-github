  },
  "license": "MIT",
  "icon": "https://raw.githubusercontent.com/veyne0/prefab-custom-addon/main/docs/mod_cover.png",
  "environment": "client",
  "gameVersions": ["1.21.1"],
  "loaders": ["neoforge"],
  "dependencies": {
    "neoforge": ">=21.1.233",
    "minecraft": ">=1.21.1",
    "prefab": {
      "projectId": "prefab",
      "versionRange": ">=1.0.7",
